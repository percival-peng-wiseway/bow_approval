{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "bow-oa",
  "pages_build_output_dir": "./public",
  "compatibility_date": "2026-10-22",
  "services": [{ "binding": "BOW", "service": "bow-approval" }],
  "env": {
    "preview": {
      "services": [{ "binding": "BOW", "service": "bow-approval-qa" }]
    }
  }
}
